# Example environment variables. Copy to `.env` for reference, but note that
# nothing in this project loads a .env file (python-dotenv is not a dependency)
# - these are read from the process environment via config.py.
#
# Every value below is optional; config.py has sane defaults for all of them.
# NO API KEYS ARE REQUIRED. All models run locally from the Hugging Face Hub.

# --- Observability -----------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Detection ---------------------------------------------------------------
DETECTION_THRESHOLD=0.5

# --- Upload limits -----------------------------------------------------------
MAX_UPLOAD_MB=10
MAX_PIXELS_MP=50

# --- Demo guardrails ---------------------------------------------------------
# Per-browser-session only; NOT a server-side rate limit.
MAX_RUNS_PER_HOUR=10

# --- Concurrency -------------------------------------------------------------
# Models are process-global and shared across sessions; 1 serializes inference.
MAX_CONCURRENT_INFERENCES=1

# --- Captioning budget -------------------------------------------------------
MIN_CROP_PIXELS=32
MAX_DESCRIPTIONS_PER_IMAGE=10

# --- Artifacts ---------------------------------------------------------------
# Off by default: results are served as in-memory downloads and nothing is
# written to disk. Enable only if you want per-run directories under data/runs.
PERSIST_ARTIFACTS=false
ARTIFACT_TTL_HOURS=24
MAX_STORED_RUNS=50

# --- Model pins --------------------------------------------------------------
# Pinned to tested commit SHAs. Overriding with a branch name like `main` gives
# up version reproducibility and lets upstream changes alter results silently.
DETR_MODEL_ID=facebook/detr-resnet-50
DETR_REVISION=1d5f47bd3bdd2c4bbfa585418ffe6da5028b4c0b
BLIP_MODEL_ID=Salesforce/blip-image-captioning-base
BLIP_REVISION=82a37760796d32b1411fe092ab5d4e227313294b
